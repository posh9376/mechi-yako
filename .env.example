# Copy to .env locally. Never commit .env.
# Foundry is optional: without these, the template explainer still runs.

# template | foundry  (foundry falls back to template if the call fails)
MECHI_EXPLAINER=template

# From Foundry project mechi-yako → gpt-5-mini → Continue in code.
# Either the resource root or .../openai/v1/responses works.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Latency tuning (all optional).
# Overall deadline per Foundry call; slower calls fall back to the template.
MECHI_FOUNDRY_TIMEOUT_S=10
# minimal | low | medium | high; empty sends no reasoning setting.
MECHI_FOUNDRY_REASONING=minimal
# Explanation cache file (default .cache/explanations.json); empty keeps it in memory only.
# MECHI_EXPLANATION_CACHE=.cache/explanations.json
# 1 explains every moment in the background at startup; 0 explains on first request.
MECHI_EXPLAINER_PREWARM=1
